    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@seatrush/eslint-config": "workspace:^",
    "@seatrush/tsconfig": "workspace:^",
    "@types/express": "^5.0.6",
