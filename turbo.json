{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "REDIS_URL", "PORT", "WEB_URL", "API_URL", "ADMIN_TOKEN", "ACCESS_TOKEN_SECRET", "PAYOS_*", "SEATRUSH_*", "NODE_ENV"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "env": ["NEXT_PUBLIC_*"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true }
  }
}
